<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_pricelist_button')]" position="after">
            <button t-if="this.pos.cashier._role != 'minimal'" class="o_fiscal_close_button" t-att-class="buttonClass" t-on-click="() => this.clickFiscalXClose()">
                <i class="fa fa-times me-2" role="img" aria-label="X Close" title="X Close" />
                Cierre X
            </button>
            <button t-if="this.pos.cashier._role != 'minimal'" class="o_fiscal_close_button" t-att-class="buttonClass" t-on-click="() => this.clickFiscalZClose()">
                <i class="fa fa-moon-o me-2" role="img" aria-label="Z Close" title="Z Close" />
                Cierre Z
            </button>

        </xpath>
    </t>
</templates>
