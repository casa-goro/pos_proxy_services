<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_inherit_fiscal_printer" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.fiscal.printer</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='order_fields']/field[@name='session_id']" position="after">
                <field name="fiscal_ticket_printed" readonly="1"/>
                <button name="action_reimprimir_ticket_fiscal" type="object"
                    string="Reimprimir ticket fiscal" class="oe_link" colspan="2"/>
            </xpath>
        </field>
    </record>
</odoo>
